# ─── Database ────────────────────────────────────────────
# DATABASE_URL tiene precedencia: si está definida, las cinco variables sueltas de abajo
# se ignoran (cambiar solo DATABASE_NAME no tendría ningún efecto). Coméntala para usarlas.
DATABASE_URL=postgresql://loklflow:loklflow@localhost:5432/loklflow_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=loklflow
DATABASE_PASSWORD=loklflow
DATABASE_NAME=loklflow_db
# Solo para un Postgres gestionado, que no acepta conexiones sin TLS. En local y en CI
# se deja en false: ni docker-compose ni el servicio del runner hablan TLS.
DATABASE_SSL=false

# ─── Redis ───────────────────────────────────────────────
# Declarado pero sin usar todavía: nada del backend abre una conexión a Redis. Se conserva
# para el adaptador de Socket.io cuando haya más de una instancia de la API.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────
# Genera cada secreto con:  openssl rand -base64 48
# La API se niega a arrancar si falta alguno o si sigue con el valor "change-this-*".
JWT_SECRET=change-this-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Next.js ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
